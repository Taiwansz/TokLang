{
  "name": "toklang",
  "version": "2.0.0",
  "description": "Deterministic, BPE-verified, negation-safe, and Cache-Aware (CAPC) prompt compiler for LLMs",
  "main": "js/sdk-lib.js",
  "bin": {
    "toklang": "./cli.js"
  },
  "scripts": {
    "start": "node server.js",
    "test:core": "node --test tests/v2_core.test.js",
    "test:unit": "NODE_ENV=test node tests/run.js",
    "test:py": "pytest python/tests/test_toklang_v2.py",
    "test:e2e": "NODE_ENV=test npx playwright test --project=firefox",
    "test": "npm run test:core && npm run test:unit && npm run test:e2e",
    "benchmark": "node scripts/benchmark_v2.js",
    "compare": "node tests/compare_quality.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.20.0",
    "@supabase/supabase-js": "^2.39.8",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "js-tiktoken": "^1.0.21",
    "resend": "^6.16.0",
    "stripe": "^14.0.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "playwright": "^1.61.1",
    "vercel": "^34.0.0"
  }
}
