{
  "manifest_version": 3,
  "name": "TokLang - Prompt Compressor",
  "version": "1.0.0",
  "description": "Comprime seus prompts automaticamente no ChatGPT, Claude e Gemini usando a Engine do TokLang.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "icons": {
    "128": "icon.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*"
      ],
      "js": ["toklang-engine.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
